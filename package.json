{
  "name": "secret-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/battle.ts --test-coverage-include=src/content.ts --test-coverage-include=src/progress.ts --test-coverage-include=src/i18n.ts tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
